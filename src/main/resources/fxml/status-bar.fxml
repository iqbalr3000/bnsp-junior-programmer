<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="24" styleClass="status-bar"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iqbal.ui.controller.StatusBarController">
    <padding>
        <Insets top="4" right="12" bottom="4" left="12"/>
    </padding>
    <Label fx:id="memoryLabel" styleClass="text-caption"/>
    <Label fx:id="dbPoolLabel" styleClass="text-caption"/>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.iqbal.ui.controller.ChatController">
    <top>
        <VBox styleClass="chat-header">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="AI Assistant" styleClass="title-label"/>
            <Label fx:id="statusLabel" styleClass="text-caption"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="historyScrollPane" fitToWidth="true" BorderPane.alignment="CENTER">
            <VBox fx:id="messageContainer" spacing="10">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="8" alignment="CENTER">
            <padding>
                <Insets top="12" right="16" bottom="16" left="16"/>
            </padding>
            <TextField fx:id="inputField" promptText="Tanya sesuatu, mis. 'cek stok paracetamol'" HBox.hgrow="ALWAYS" onAction="#handleKirim"/>
            <Button fx:id="kirimButton" text="Kirim" onAction="#handleKirim"/>
        </HBox>
    </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" styleClass="login-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iqbal.ui.controller.LoginController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label text="Sistem Informasi Manajemen Rumah Sakit" wrapText="true" textAlignment="CENTER" styleClass="title-label"/>
    <Label text="Silakan masuk untuk melanjutkan" styleClass="text-caption"/>
    <TextField fx:id="usernameField" promptText="Username" maxWidth="280"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="280"/>
    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
    <Button fx:id="loginButton" text="Masuk" defaultButton="true" maxWidth="280" onAction="#handleLogin"/>
    <Label text="Demo: admin / admin123" styleClass="text-caption"/>
</VBox>
